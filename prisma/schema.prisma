generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@map("rate_limit_bucket")
}

/// RG1 : un utilisateur a zéro ou une filière actuelle ; une filière peut concerner plusieurs utilisateurs.
model Utilisateur {
  id                      String     @id @default(cuid())
  anonymousTokenHash      String?    @unique @map("anonymousToken")
  anonymousTokenExpiresAt DateTime?
  niveauEtudes            String?
  serieTerminale          String?
  filiereActuelleId       String?
  filiereSouhaitee        String?
  scoreRealiste           Int        @default(0)
  scoreInvestigateur      Int        @default(0)
  scoreArtistique         Int        @default(0)
  scoreSocial             Int        @default(0)
  scoreEntreprenant       Int        @default(0)
  scoreConventionnel      Int        @default(0)
  profilDominant          String?
  localisation            String?
  ambition                Int?
  rythme                  Int?
  autonomie               Int?
  styleTravail            String?
  toleranceStress         Int?
  dateCreation            DateTime   @default(now())
  feedbacks               Feedback[]
  sessions                Session[]
  filiereActuelle         Filiere?   @relation("FiliereActuelle", fields: [filiereActuelleId], references: [id])

  @@map("utilisateur")
}

model Filiere {
  id                        String          @id @default(cuid())
  nom                       String
  description               String?
  profilRealiste            Int             @default(0)
  profilInvestigateur       Int             @default(0)
  profilArtistique          Int             @default(0)
  profilSocial              Int             @default(0)
  profilEntreprenant        Int             @default(0)
  profilConventionnel       Int             @default(0)
  conditionsAcces           String?
  etablissementsDisponibles String?
  duree                     String?
  debouchesText             String?
  domaines                  String?
  avantagesFinanciers       String?
  inconvenientsFinanciers   String?
  avantagesMentaux          String?
  inconvenientsMentaux      String?
  avantagesPhysiques        String?
  inconvenientsPhysiques    String?
  conseils                  String?
  metiers                   FiliereMetier[]
  utilisateurs              Utilisateur[]   @relation("FiliereActuelle")

  @@map("filiere")
}

model Metier {
  id                   String           @id @default(cuid())
  nom                  String
  description          String?
  profilRealiste       Int              @default(0)
  profilInvestigateur  Int              @default(0)
  profilArtistique     Int              @default(0)
  profilSocial         Int              @default(0)
  profilEntreprenant   Int              @default(0)
  profilConventionnel  Int              @default(0)
  secteurActivite      String?
  descriptionDebouches String?
  salaireMoyen         String?
  competencesCles      String?
  niveauMinimum        String?
  filieres             FiliereMetier[]
  recommandations      Recommandation[]

  @@map("metier")
}

/// RG2 : une filière peut mener à plusieurs métiers ; un métier peut être accessible depuis plusieurs filières.
model FiliereMetier {
  filiereId String
  metierId  String
  filiere   Filiere @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  metier    Metier  @relation(fields: [metierId], references: [id], onDelete: Cascade)

  @@id([filiereId, metierId])
  @@map("filiere_metier")
}

/// RG3 : un utilisateur peut avoir plusieurs sessions ; une session appartient à un seul utilisateur.
model Session {
  id              String           @id @default(cuid())
  utilisateurId   String
  dateDebut       DateTime         @default(now())
  dateFin         DateTime?
  statut          String           @default("active")
  interactions    Interaction[]
  recommandations Recommandation[]
  utilisateur     Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Intention {
  id           String        @id @default(cuid())
  libelle      String        @unique
  description  String?
  interactions Interaction[]

  @@map("intention")
}

/// RG4 : une session contient plusieurs interactions ; une interaction appartient à une seule session.
/// RG5 : une interaction porte sur une seule intention ; une intention peut concerner plusieurs interactions.
model Interaction {
  id                 String     @id @default(cuid())
  sessionId          String
  intentionId        String?
  dateHeure          DateTime   @default(now())
  messageUtilisateur String?
  reponseSysteme     String?
  metadata           String?
  intention          Intention? @relation(fields: [intentionId], references: [id])
  session            Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interaction")
}

/// RG6 : une session peut générer plusieurs recommandations ; une recommandation appartient à une seule session.
/// RG7 : un métier peut faire l'objet de plusieurs recommandations ; une recommandation concerne un seul métier.
model Recommandation {
  id                 String   @id @default(cuid())
  sessionId          String
  metierId           String
  scoreCompatibilite Float
  justification      String
  dateGeneration     DateTime @default(now())
  metier             Metier   @relation(fields: [metierId], references: [id], onDelete: Cascade)
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("recommandation")
}

/// Questions du test RIASEC (modèle de Holland).
model QuestionRiasec {
  id        String @id @default(cuid())
  dimension String
  ordre     Int
  enonce    String

  @@map("question_riasec")
}

/// Demandes de redirection vers un conseiller humain.
model DemandeConseiller {
  id            String   @id @default(cuid())
  sessionId     String?
  utilisateurId String?
  nom           String?
  contact       String?
  motif         String
  urgence       String   @default("normale")
  traitee       Boolean  @default(false)
  dateDemande   DateTime @default(now())

  @@map("demande_conseiller")
}

/// Feedback utilisateur sur les réponses du bot — permet à l'IA d'apprendre de ses erreurs.
model Feedback {
  id                 String       @id @default(cuid())
  utilisateurId      String?
  sessionId          String?
  interactionId      String?
  messageUtilisateur String
  reponseBot         String
  intentionDetectee  String?
  note               Int
  correction         String?
  intentionCorrecte  String?
  dateFeedback       DateTime     @default(now())
  utilisateur        Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

/// Apprentissage NLU dynamique — mots-clés ajoutés/corrigés via feedback.
model ApprentissageNlu {
  id        String   @id @default(cuid())
  intention String
  motCle    String
  source    String   @default("feedback")
  poids     Int      @default(1)
  dateAjout DateTime @default(now())

  @@unique([intention, motCle])
  @@map("apprentissage_nlu")
}
